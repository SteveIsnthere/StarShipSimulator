+    expect(Object.keys(a), path).toEqual(Object.keys(b));
+    for (const key of Object.keys(a)) exact((a as Record<string, unknown>)[key], (b as Record<string, unknown>)[key], `${path}.${key}`);
+  } else expect(a, path).toBe(b);
