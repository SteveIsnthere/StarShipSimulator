+          return Reflect.get(target, key, receiver);
+        },
+      });
+      let result: number | null | undefined, caught: unknown;
+      try { result = solver(3, 330000, 30, 90.5, scratch, model); } catch (e) { caught = e; }
+      return { log, scratch, result, caught };
+    };
