+ const env={...process.env,STARSHIP_NATIVE_BENCH_MANIFEST:native.manifestPath,STARSHIP_NATIVE_BENCH_DIGEST:native.digest,STARSHIP_NATIVE_BENCH_INVOCATION:invocation,STARSHIP_NATIVE_BENCH_RECEIPT:receipt};
