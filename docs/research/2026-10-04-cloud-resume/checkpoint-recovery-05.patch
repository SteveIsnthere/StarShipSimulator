+  if(!source.valid || !source.expected || source.expectedDt!==dt
+    || !equalBoosterTree(source.expected,state)) {revoke(state);return false;}
+  if(a.boosterReturnPlan && a.boosterReturnPlan.sourceLineage!==source.lineageId) {
