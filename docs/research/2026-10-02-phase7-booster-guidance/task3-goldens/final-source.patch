+export interface BoosterBurnCandidate {
+  originTime:number;
+  burnDuration:number;
+  shutdownAt:number;
+  coastPitch:Rad;
+  forecast:BoosterForecast;
+}
+export interface BoosterReturnPlan {
+  originTime:number;
+  shutdownAt:number;
+  coastPitch:Rad;
+  handoff:NonNullable<BoosterForecast['handoff']>;
