index 0000000..5bf867b
--- /dev/null
+++ b/src/core/control/booster-prediction.ts
@@ -0,0 +1,81 @@
+/** Deterministic work scheduling for expensive planned physical forecasts.
+ * Progress is flight state, not a worker/global cache or wall-clock response. */
+import { cloneState,type SimState } from '../state';
+import type { VehicleDefinition } from '../vehicle';
+import { rad } from '../units';
+import type { MechanicalAdvance,MechanicalControl } from './mechanical';
+import { advanceBoosterForecast,createBoosterForecastWork,type BoosterForecastWork,type BoosterForecast } from './booster-forecast';
+
+interface PublishedPrediction {
+  originTime:number;originX:number;originVX:number;forecast:BoosterForecast;slope?:number|undefined;
+  /** m/s — measured return-error derivative per second of paid boost. */
+  burnRangeRate?:number|undefined;
+}
+export interface BoosterPrediction {
+  /** Immutable source for matching0/±.05rad rollouts; has no nested job. */
+  origin:SimState;
+  rollout:BoosterForecastWork;
+  candidate:0|1|2;
+  plus?:number;
+  published?:PublishedPrediction|undefined;
+  done:boolean;
+}
+
+/** Four mechanical advances per1/120s live step. This is a procedural work
+ * budget, not a control authority/physical coefficient. Same simulated dt and
+ * state always schedule the same work; the gate checks counts, bench checks ms. */
+export function advanceBoosterPrediction(state:SimState,dt:number,advance:MechanicalAdvance,policy:MechanicalControl,model:VehicleDefinition):number {
+  const a=state.autopilot,prior=a.boosterPrediction;
+  let next:BoosterPrediction;
+  if(!prior || prior.done) {
+    const origin=cloneState(state);delete origin.autopilot.boosterPrediction;
+    next={origin,rollout:createBoosterForecastWork(origin,rad(0)),candidate:0,done:false,published:prior?.published};
+  } else {
+    // cloneState deliberately shares immutable job snapshots. Resume into new
+    // owned job/result/mechanics so previous live frames cannot be mutated.
+    next={...prior,rollout:{...prior.rollout,state:cloneState(prior.rollout.state),result:{...prior.rollout.result}}};
+  }
+  const used=advanceBoosterForecast(next.rollout,Math.max(1,Math.floor(480*dt)),advance,policy,model);
+  if(next.rollout.done) {
+    const result=next.rollout.result;
+    if(next.candidate===0) {
+      next.published={originTime:next.origin.world.environmentTime,
+        originX:next.origin.kinematics.downRangeDistance,originVX:next.origin.kinematics.speedX,
+        forecast:{...result},slope:prior?.published?.slope,burnRangeRate:prior?.published?.burnRangeRate};
+      if(next.origin.autopilot.boosterPhase==='coast' || next.origin.autopilot.boosterPhase==='boostback') {
+        next.candidate=1;
+        next.rollout=next.origin.autopilot.boosterPhase==='boostback'
+          ?createBoosterForecastWork(next.origin,rad(0),.25):createBoosterForecastWork(next.origin,rad(.05));
+      } else next.done=true;
+    } else if(next.candidate===1) {
+      next.plus=result.rangeError;next.candidate=2;
+      next.rollout=next.origin.autopilot.boosterPhase==='boostback'
+        ?createBoosterForecastWork(next.origin,rad(0),.5):createBoosterForecastWork(next.origin,rad(-.05));
+    } else {
+      if(next.origin.autopilot.boosterPhase==='boostback') {
+        // Forward finite difference through actual continuing boost, including
+        // ignition, attitude, pressure, throttle and paid propellant. The
+        // endpoint response includes planned entry/terminal feedback.
+        next.published={...next.published!,burnRangeRate:(result.rangeError-next.published!.forecast.rangeError)/.5};
+      } else next.published={...next.published!,slope:(next.plus!-result.rangeError)/.1};
+      next.done=true;
+    }
+  }
+  a.boosterPrediction=next;
+  const p=next.published;
+  if(p) {
+    const elapsed=Math.max(0,state.world.environmentTime-p.originTime);
+    const remaining=Math.max(0,p.forecast.time-elapsed);
+    // First-order transport while a newer physical rollout is in progress.
+    // Current position and paid velocity changes are observed each live step;
+    // we never wait for a wall-clock callback to decide the boost cutoff.
+    a.boosterRangeError=a.boosterPhase==='boostback'
+      ?p.forecast.rangeError+(p.burnRangeRate ?? 0)*elapsed
+      :p.forecast.rangeError+state.kinematics.downRangeDistance-p.originX-p.originVX*elapsed
+        +(state.kinematics.speedX-p.originVX)*remaining;
+    a.boosterFallTime=remaining;a.boosterForecastReached=p.forecast.reached;
+    if(a.boosterPhase==='coast' && p.slope!==undefined && Math.abs(p.slope)>1)
+      a.boosterCoastPitch=rad(Math.max(-.2,Math.min(.2,-a.boosterRangeError/p.slope)));
+  }
+  return used;
+}
