{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "$core/*": ["src/core/*"],
      "$app/*": ["src/app/*"],
      "$view/*": ["src/view/*"],
      "$hud/*": ["src/hud/*"],
      "$ui/*": ["src/ui/*"],
      "$audio/*": ["src/audio/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "scripts/**/*.mjs", "*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist", "tests/lint-walls/fixtures"]
}
