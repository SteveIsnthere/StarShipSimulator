{
  "name": "starship-simulator-v2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.kit.json && svelte-check --tsconfig ./tsconfig.json && node scripts/check-design-contract.mjs && node scripts/check-ui-contract.mjs && vite build && node scripts/build-sw.mjs dist && node scripts/check-budget.mjs && node scripts/check-entry-graph.mjs dist",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=120000",
    "gate": "npm run lint && npm run build && npm run test && npm run coverage && E2E_SKIP_BUILD=1 npm run test:e2e && E2E_SKIP_BUILD=1 npm run test:deploy",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --grep @smoke",
    "test:deploy": "playwright test --config playwright.subpath.config.ts",
    "golden:regenerate": "vite-node tests/golden/regenerate.ts",
    "bench": "vitest run --config vitest.timing.config.ts",
    "test:e2e:full": "playwright test",
    "truth:report": "vite-node scripts/truth-report.ts",
    "mutation": "node scripts/mutation-check.mjs",
    "kit:drift": "node scripts/kit-drift.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-svelte": "3.23.0",
    "fast-check": "4.10.2",
    "globals": "17.11.0",
    "jsdom": "29.1.0",
    "node-web-audio-api": "^2.2.0",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-node": "6.0.0",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "0.468.0",
    "pixi.js": "8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0",
    "uplot": "1.6.32",
    "zustand": "5.0.12"
  }
}
